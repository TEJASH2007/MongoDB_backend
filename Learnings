# query Operators
1 : find students where marks > 75
ans : db.student.find( {marks : {$gt : 75}} )

2 : find student who live in delhi or mumbai
ans : db.student.find( {city : {$in : ["delhi" , "Mumbai"] } } );

3 : find student who scored > 75 or live in delhi
ans : db.student.find( {$or : [ {marks : { $gt : 75 } } , { city : 'delhi' } ]} );

